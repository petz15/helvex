# ============================================================
# DEV ENVIRONMENT — local development only
# NEVER point these at production resources.
# Copy to .env and fill in the blanks.
# ============================================================

APP_ENV=dev

# Local Postgres (Docker Compose default)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=helvex
POSTGRES_PASSWORD=helvex_dev
POSTGRES_DB=helvex_dev

# Zefix API — public, no auth required for basic queries
ZEFIX_API_BASE_URL=https://www.zefix.admin.ch/ZefixREST/api/v1
ZEFIX_API_USERNAME=
ZEFIX_API_PASSWORD=

# Serper.dev — use a SEPARATE dev API key with a low daily cap (e.g. 20 calls/day)
# Get one at https://serper.dev — free tier gives 2500 credits total
GOOGLE_SEARCH_ENABLED=true
SERPER_API_KEY=your_DEV_serper_key_here
GOOGLE_DAILY_QUOTA=20

# Admin user (dev only — use a throwaway password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dev_admin_password

# Generate a random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev_secret_key_at_least_32_chars_long_replace_me

# Disable Stripe/Worldline in dev unless explicitly testing payments
PAYMENT_PROVIDER_MODE=worldline
WORLDLINE_API_BASE_URL=https://payment.preprod.direct.worldline-solutions.com
WORLDLINE_CUSTOMER_ID=
WORLDLINE_TERMINAL_ID=
WORLDLINE_API_USERNAME=
WORLDLINE_API_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# S3 — use a dev bucket prefix, not the prod bucket
# Either point at a local MinIO instance or use a separate Hetzner bucket
S3_BUCKET_EXPORTS=helvex-dev-exports
S3_BUCKET_MODELS=helvex-dev-models
# S3_ENDPOINT_URL=http://localhost:9000  # uncomment for local MinIO
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=eu-central-1

# Redis — optional in dev (thread mode works without it)
# REDIS_URL=redis://localhost:6379/0

# Email — disable SMTP in dev; emails are logged to console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=noreply@localhost

# OAuth — leave blank unless testing OAuth locally
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

APP_BASE_URL=http://localhost:8000

# ============================================================
# PROD values live ONLY in:
#   - GitHub Actions secrets (CI/CD)
#   - K8s sealed-secrets / external-secrets-operator
# Never copy prod values into this file or commit any .env file.
# ============================================================
