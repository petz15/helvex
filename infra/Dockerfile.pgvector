# Build pgvector PostgreSQL 16 image with proper semantic versioning
# Usage: docker build -f infra/Dockerfile.pgvector -t myregistry/pgvector-postgresql:16.4.0 .
FROM ghcr.io/cloudnative-pg/postgresql:16.4

USER root

# Install build dependencies and clone pgvector
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    postgresql-server-dev-16 \
    git \
    && rm -rf /var/lib/apt/lists/*

# Build and install pgvector
RUN git clone --depth 1 --branch v0.7.0 https://github.com/pgvector/pgvector.git /tmp/pgvector && \
    cd /tmp/pgvector && \
    make && \
    make install && \
    rm -rf /tmp/pgvector

# Clean up build dependencies
RUN apt-get remove -y build-essential postgresql-server-dev-16 git && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

USER postgres
